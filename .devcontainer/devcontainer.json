{
  // Test-execution isolation devcontainer -- see
  // efforts/active/devcontainer-test-isolation/README.md for the design
  // rationale behind every non-default setting below. This spec is NOT a
  // general interactive development environment (that remains
  // `agent-containers`' own trusted-development-venue posture, a separate
  // concern); it exists solely so a plugin's pytest suite can run with a
  // real OS-level filesystem/privilege boundary instead of (or on top of)
  // `tools/run-plugin-tests.py`'s existing process-level containment.
  // Networking is NOT (yet) part of that boundary -- see this file's own
  // networking comment below, a known, named, open design gap.
  //
  // Linux-only (this repo's CI already covers the Windows-specific
  // containment paths `TESTING.md` describes via its own windows-latest
  // runner -- see Phase 0's scope decision).
  "name": "copilot-extensions-test-isolation",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Workspace storage model (Phase 1, item 1): a naive devcontainer binds
  // the host checkout read-write by default, so a file written from inside
  // the container is immediately visible, modified, on the HOST filesystem
  // -- a regression versus `run-plugin-tests.py`'s containment, not an
  // improvement. This spec therefore overrides the default workspace mount
  // with a container-local Docker VOLUME (never a bind of any host path,
  // and size-bounded -- see `tools/run_tests_in_devcontainer.py`'s
  // `_create_bounded_volume`) -- the host checkout is never mounted into
  // the container at all. `tools/run_tests_in_devcontainer.py` populates
  // this volume from a point-in-time COPY of the host checkout (via a tar
  // pipe into `docker exec`, mirroring the repo-materialization pattern in
  // `plugins/agent-containers/src/agent_containers/devcontainer_launch.py`)
  // after the container is up, so the host checkout is only ever READ,
  // never mutated, by anything that happens inside the container
  // afterward.
  "workspaceMount": "source=copilot-extensions-test-isolation-ws,target=/workspaces/copilot-extensions,type=volume",
  "workspaceFolder": "/workspaces/copilot-extensions",

  // Runtime-posture hardening (Phase 1, item 2) -- mirrors the
  // restricted-fleet invariants this repo enforces for
  // `agent-containers`' own dispatched-development containers
  // (`plugins/agent-containers/src/agent_containers/fleet.py`'s restricted
  // run-args, checked by `lifecycle.py`'s `restricted_policy_errors`, whose
  // own fixed writable-surface set is exactly `{workspace, home, /tmp,
  // /run}` -- the same four surfaces declared here): drop every Linux
  // capability (the base image needs none of them to run pytest), forbid
  // privilege escalation, and keep the root filesystem read-only so only
  // these explicitly declared writable surfaces can be written at all.
  // `/home/vscode` specifically must be writable, not just `/tmp`/`/run` --
  // the devcontainer CLI's OWN lifecycle-hook bookkeeping (a marker file
  // under `$HOME`) silently fails without it, which in turn silently skips
  // `onCreateCommand` (and would equally break any real tool, like `uv`,
  // that installs into `$HOME`). `/home/vscode` and `/run` both need an
  // explicit `mode=1777` (world-writable + sticky, the same pattern Docker
  // already applies to `/tmp` by default) -- a bare tmpfs mount is created
  // `root:root 0755` by default, which the non-root `vscode` remote user
  // cannot write into; `mode=1777` avoids hardcoding that user's uid/gid
  // (observed as 1001 on the current base image, but not a stable constant
  // across image updates). `/home/vscode` and `/tmp` additionally need an
  // explicit `exec` option -- Docker's own tmpfs default is `noexec`, which
  // would otherwise prevent executing the installed `uv` binary from
  // `$HOME/.local/bin`; `uv`'s own binary, and anything pytest builds/
  // writes into a temp dir at runtime, both need to execute from these two
  // surfaces. `/run` has no such need and stays `noexec`. No Docker-socket
  // mount is present anywhere in this file, and none should be added by a
  // future feature without a deliberate, documented reason -- a mounted
  // socket is a full host-escape vector, and the naive baseline this spec
  // replaces does NOT expose one by default. Hard resource ceilings
  // (`--memory`/`--memory-swap`/`--cpus`/`--pids-limit`) mirror the same
  // restricted-fleet invariants cited above
  // (`plugins/agent-containers/src/agent_containers/fleet.py`'s restricted
  // run-args; `lifecycle.py`'s `restricted_policy_errors` treats these as
  // fixed, checked invariants, not optional tuning) -- without them, a
  // test could exhaust host RAM/CPU or fork-bomb outside of (or even
  // before) `tools/run-plugin-tests.py`'s OWN inner per-sub-suite bounds
  // ever get a chance to act. `--memory=12g` is sized for the COMBINED
  // inner budgets, not just one of them: that runner's own
  // `--max-memory-mb` (4096 MiB resident) and `--max-temp-mb` (2048 MiB,
  // tmpfs-backed and therefore ALSO charged to this same memory cgroup)
  // defaults already sum to 6144 MiB before accounting for the container
  // itself (git, uv, the Python interpreter, `pytest` bookkeeping), the
  // tmpfs-backed `$HOME`/`/tmp`/`/run` mounts below, or the tmpfs-backed
  // workspace volume (`_create_bounded_volume`, also charged to this same
  // cgroup) -- a smaller ceiling could OOM-kill a perfectly valid,
  // within-budget suite. `/tmp`'s own `size=3072m` specifically must stay
  // above that same runner's own advertised `--max-temp-mb` default (2048
  // MiB) for the same reason -- a smaller outer `/tmp` ceiling would let a
  // legitimate, within-budget inner suite hit `ENOSPC` on the OUTER
  // boundary before the inner runner's own guard ever gets a chance to
  // enforce its own limit. (A tmpfs `size=` is only a ceiling on actual
  // bytes written, not a reservation, so none of this headroom inflates
  // the container's real memory footprint in the common case -- the
  // overall `--memory` cgroup limit above remains the real backstop
  // regardless of any single mount's nominal cap.)
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--read-only",
    "--memory=12g",
    "--memory-swap=12g",
    "--cpus=4",
    "--pids-limit=512",
    "--tmpfs", "/home/vscode:rw,nosuid,nodev,exec,mode=1777,size=256m",
    "--tmpfs", "/tmp:rw,nosuid,nodev,exec,size=3072m",
    "--tmpfs", "/run:rw,nosuid,nodev,mode=1777,size=64m"
  ],

  // `uv`'s default cache dir is `$HOME/.cache/uv` -- the 256 MiB
  // `$HOME` mount above is sized for `uv`'s own small install footprint,
  // not for retaining every downloaded/unpacked wheel across a plugin's
  // (or `--all`'s) dependency install for the container's lifetime; a
  // heavier dependency set (large scientific/ML/vector-search packages
  // some plugins' dev extras pull in) can hit `ENOSPC` there well before
  // the 4 GiB workspace volume is anywhere near full. Point it at `/tmp`
  // instead, which already has real headroom (see `runArgs` above) and is
  // torn down with the rest of the container regardless.
  "containerEnv": {
    "UV_CACHE_DIR": "/tmp/uv-cache"
  },

  // Networking (Phase 1, item 2, open/residual): left at Docker's default
  // bridge network with full outbound reach for now, because dependency
  // resolution (`uv sync` inside `tools/run-plugin-tests.py`, invoked via
  // `run_tests_in_devcontainer.py`) and the test run itself currently share
  // one process and have not yet been split into a network-enabled "prime
  // the venv cache" pass and a network-disconnected "run pytest" pass. See
  // the effort README's Phase 1 journal entry for why this is recorded as a
  // deliberate, named gap rather than silently left unaddressed.

  "remoteUser": "vscode",
  "containerUser": "vscode",

  // Installs a PINNED, SHA-256-VERIFIED `uv` release directly from its
  // GitHub release archive -- the installed `uv` persists in
  // `/home/vscode` and runs again on every later `devcontainer exec`
  // (`tools/run-plugin-tests.py` itself invokes it), with the checkout
  // snapshot already present and the container's deliberately enabled
  // outbound network reachable by then. The previous `curl ... | sh` form
  // executed astral.sh's OWN mutable installer script with no version pin
  // or integrity check at all -- a compromised or unexpectedly changed
  // installer would have had everything it needed to defeat this spec's
  // entire isolation boundary. Version and per-architecture SHA-256 values
  // below are the SAME pinned, already-vetted values this repo's own
  // `libs/installer-engine/installer-engine.sh`'s `ensure_uv` uses (kept
  // in sync by hand, not by import -- that script is a shell library this
  // single JSON string can't source). `onCreateCommand` runs before
  // `run_tests_in_devcontainer.py` has populated the workspace volume with
  // repository content, so nothing here may assume the checkout (e.g.
  // `pyproject.toml`) is present yet -- only `uv` itself is installed.
  "onCreateCommand": "set -eu; UV_VERSION=0.12.6; ARCH=$(uname -m); case \"$ARCH\" in x86_64) ASSET=uv-x86_64-unknown-linux-gnu.tar.gz; EXPECTED_SHA=8681d8921e7d520fb368991dcf5f9c1905b80f5bf2a265a0ed085c8d8e342477 ;; aarch64) ASSET=uv-aarch64-unknown-linux-gnu.tar.gz; EXPECTED_SHA=d58030acd26159499ac82f32da12d1b3c12a3a1bfc414232d9082070c03e128d ;; *) echo \"unsupported uv bootstrap architecture: $ARCH\" >&2; exit 1 ;; esac; curl -LsSf \"https://github.com/astral-sh/uv/releases/download/$UV_VERSION/$ASSET\" -o /tmp/uv.tar.gz; ACTUAL_SHA=$(sha256sum /tmp/uv.tar.gz | awk '{print $1}'); if [ \"$ACTUAL_SHA\" != \"$EXPECTED_SHA\" ]; then echo \"uv archive SHA-256 mismatch for $ASSET (expected $EXPECTED_SHA, got $ACTUAL_SHA)\" >&2; exit 1; fi; mkdir -p \"$HOME/.local/bin\"; tar -xzf /tmp/uv.tar.gz -C /tmp; mv /tmp/uv-*/uv /tmp/uv-*/uvx \"$HOME/.local/bin/\"; rm -rf /tmp/uv.tar.gz /tmp/uv-*"
}
